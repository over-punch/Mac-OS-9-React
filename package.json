{
	"name": "@liiift-studio/mac-os9-ui",
	"version": "2.6.0",
	"description": "A pixel-perfect Mac OS 9 UI component library for React and TypeScript",
	"private": false,
	"sideEffects": [
		"*.css",
		"**/*.css"
	],
	"type": "module",
	"main": "./dist/cjs/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/cjs/index.cjs"
			}
		},
		"./styles": "./dist/index.css",
		"./tokens": "./dist/tokens.css",
		"./webfonts": "./dist/webfonts.css",
		"./base": "./dist/base.css",
		"./fonts/*": "./dist/fonts/*",
		"./package.json": "./package.json",
		"./platinum": {
			"import": {
				"types": "./dist/types/platinum/index.d.ts",
				"default": "./dist/platinum/index.js"
			},
			"require": {
				"types": "./dist/types/platinum/index.d.ts",
				"default": "./dist/cjs/platinum/index.cjs"
			}
		},
		"./platinum.css": "./dist/platinum.css"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"ATTRIBUTION.md"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"dev": "storybook dev -p 6006",
		"site:dev": "vite --config site/vite.config.ts",
		"site:build": "vite build --config site/vite.config.ts",
		"site:preview": "vite preview --config site/vite.config.ts",
		"capture": "npm run site:build && node scripts/capture.mjs",
		"build": "npm run clean && rollup -c",
		"build:storybook": "storybook build",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint src --ext .ts,.tsx",
		"lint:fix": "eslint src --ext .ts,.tsx --fix",
		"format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
		"format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\"",
		"typecheck": "tsc --noEmit && tsc --noEmit -p site/tsconfig.json",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "npm run build && changeset publish",
		"prepublishOnly": "npm run build",
		"measure": "node scripts/measure.mjs"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@changesets/cli": "^2.27.10",
		"@chromatic-com/storybook": "^3.2.2",
		"@eslint/js": "^9.18.0",
		"@rollup/plugin-commonjs": "^29.0.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-typescript": "^12.3.0",
		"@storybook/addon-essentials": "^8.5.0",
		"@storybook/addon-interactions": "^8.5.0",
		"@storybook/addon-links": "^8.5.0",
		"@storybook/blocks": "^8.5.0",
		"@storybook/react": "^8.5.0",
		"@storybook/react-vite": "^8.5.0",
		"@storybook/test": "^8.5.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.1.0",
		"@testing-library/user-event": "^14.5.2",
		"@types/react": "^18.3.18",
		"@types/react-dom": "^18.3.5",
		"@types/three": "^0.185.4",
		"@typescript-eslint/eslint-plugin": "^8.20.0",
		"@typescript-eslint/parser": "^8.20.0",
		"@vitejs/plugin-react": "^4.7.0",
		"@vitest/coverage-v8": "^4.1.11",
		"axe-core": "^4.13.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-react": "^7.37.2",
		"eslint-plugin-react-hooks": "^5.1.0",
		"eslint-plugin-storybook": "^0.11.1",
		"globals": "^17.11.0",
		"jsdom": "^29.1.1",
		"playwright": "^1.62.1",
		"postcss": "^8.5.6",
		"postcss-import": "^16.1.1",
		"postcss-url": "^10.1.3",
		"prettier": "^3.4.2",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"rollup": "^4.56.0",
		"rollup-plugin-copy": "^3.5.0",
		"rollup-plugin-dts": "^6.3.0",
		"rollup-plugin-peer-deps-external": "^2.2.4",
		"rollup-plugin-postcss": "^4.0.2",
		"storybook": "^8.5.0",
		"three": "^0.185.1",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^6.4.3",
		"vitest": "^4.1.11",
		"vitest-axe": "^0.1.0"
	},
	"keywords": [
		"react",
		"typescript",
		"ui",
		"components",
		"mac-os-9",
		"retro",
		"design-system"
	],
	"author": "Liiift Studio",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Liiift-Studio/Mac-OS-9-React.git"
	},
	"homepage": "https://liiift-studio.github.io/Mac-OS-9-React/",
	"bugs": {
		"url": "https://github.com/Liiift-Studio/Mac-OS-9-React/issues"
	},
	"attribution": {
		"designs": "Mac OS 9 UI Kit by Michael Feeney (https://swallowmygraphicdesign.com/project/macostalgia)",
		"license": "CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/)"
	}
}
