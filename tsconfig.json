{
	"compilerOptions": {
		"target": "ES2020",
		"useDefineForClassFields": true,
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"strict": true,
		// The library indexes into arrays and record types constantly — focusable
		// element lists, pixel maps, column arrays, regex match groups. Without
		// this, every one of those reads was typed as definitely-present when it
		// was not.
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noFallthroughCasesInSwitch": true,
		"declaration": true,
		"declarationMap": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true
	},
	// Rooted at src/ only. Pulling a root-level file into the program moves
	// TypeScript's inferred common directory to the repo root, which relocates
	// every emitted declaration and breaks the declaration bundle. The
	// jest-dom type augmentation lives in src/types/testing-library.d.ts for
	// that reason.
	"include": ["src"],
	// Tests are type-checked; stories are not. Storybook's own Meta<typeof T>
	// helper cannot express the polymorphic Button, so including stories here
	// produces hundreds of errors from the story framework rather than from
	// this code. Story breakage is caught by building Storybook in CI instead.
	"exclude": ["node_modules", "dist", "storybook-static", "**/*.stories.tsx", "**/*.stories.ts"]
}
