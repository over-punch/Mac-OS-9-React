{
	"compilerOptions": {
		"target": "ES2020",
		"useDefineForClassFields": true,
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"strict": true,
		// The library indexes into arrays and record types constantly — focusable
		// element lists, pixel maps, column arrays, regex match groups. Without
		// this, every one of those reads was typed as definitely-present when it
		// was not.
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noFallthroughCasesInSwitch": true,
		"declaration": true,
		"declarationMap": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true
	},
	// vitest.setup.ts is in the program so its `import
	// '@testing-library/jest-dom/vitest'` augments Vitest's Assertion type —
	// without it, every toBeInTheDocument in the suite is a type error.
	"include": ["src", "vitest.setup.ts"],
	// Tests are type-checked; stories are not. Storybook's own Meta<typeof T>
	// helper cannot express the polymorphic Button, so including stories here
	// produces hundreds of errors from the story framework rather than from
	// this code. Story breakage is caught by building Storybook in CI instead.
	"exclude": ["node_modules", "dist", "storybook-static", "**/*.stories.tsx", "**/*.stories.ts"]
}
