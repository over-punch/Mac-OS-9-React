{
	"compilerOptions": {
		"target": "ES2020",
		"useDefineForClassFields": true,
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"strict": true,
		// The library indexes into arrays and record types constantly — focusable
		// element lists, pixel maps, column arrays, regex match groups. Without
		// this, every one of those reads was typed as definitely-present when it
		// was not.
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noFallthroughCasesInSwitch": true,
		"declaration": true,
		"declarationMap": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src"],
	"exclude": [
		"node_modules",
		"dist",
		"storybook-static",
		"**/*.test.tsx",
		"**/*.test.ts",
		"**/*.stories.tsx",
		"**/*.stories.ts",
		"vitest.setup.ts"
	]
}
